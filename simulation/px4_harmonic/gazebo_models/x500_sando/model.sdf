<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="x500_sando">
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <link name="sando_lidar_link">
      <pose relative_to="base_link">0 0 0.30 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="sando_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/sando/lidar/scan</topic>
        <gz_frame_id>sando_lidar_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.523598775598299</min_angle>
              <max_angle>0.523598775598299</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>25</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <joint name="sando_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>sando_lidar_link</child>
    </joint>
  </model>
</sdf>